# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Backend (server only)
DATABASE_URL=postgresql://postgres:change-me@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me   # secret: server only, never in the app
APP_PORT=8080

# App (these are public by design)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=change-me
EXPO_PUBLIC_API_URL=http://localhost:8080
